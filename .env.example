# Скопируйте в .env.local и подставьте значения из Supabase:
# Project Settings -> Data API -> Project URL и Publishable/anon key.
# Это публичные значения, они попадают в собранный сайт.
# Доступ к данным ограничивает RLS из supabase/schema.sql.
VITE_SUPABASE_URL=https://ваш-проект.supabase.co
VITE_SUPABASE_ANON_KEY=ваш-публичный-ключ
